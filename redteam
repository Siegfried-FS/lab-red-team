def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def get_aws_identity():
    try:
        res = subprocess.run(["aws", "sts", "get-caller-identity", "--output", "json"],
                             capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        region = subprocess.run(["aws", "configure", "get", "region"],
                                capture_output=True, text=True).stdout.strip() or "us-east-1"
        return True, data.get("Account"), data.get("Arn"), region
    except Exception as e:
        return False, None, None, None

